<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ludusavo</RootNamespace>
    <AssemblyName>sav</AssemblyName>
    
    <Version>1.0.0</Version>
    <Description>sav - Game Save Backup CLI for Google Drive</Description>
    
    <!-- Publishing Optimizations -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(DefaultGoogleClientId)' != ''">
      <_Parameter1>DefaultGoogleClientId</_Parameter1>
      <_Parameter2>$(DefaultGoogleClientId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(DefaultGoogleClientSecret)' != ''">
      <_Parameter1>DefaultGoogleClientSecret</_Parameter1>
      <_Parameter2>$(DefaultGoogleClientSecret)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
