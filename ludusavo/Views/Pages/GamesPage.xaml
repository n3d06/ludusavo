<Page x:Class="ludusavo.Views.Pages.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:ludusavo.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:GamesViewModel}"
      Title="GamesPage"
      Background="Transparent">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Controls Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- WPF UI TextBox with built-in search icon -->
            <ui:TextBox Grid.Column="0" Margin="0,0,10,0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Tìm kiếm game..."
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"/>

            <ui:Button Grid.Column="1"
                       Content="Thêm Game Custom"
                       Command="{Binding AddCustomGameCommand}"
                       IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                       Margin="0,0,10,0"
                       Icon="{ui:SymbolIcon Add24}"/>

            <ui:Button Grid.Column="2"
                       Content="Quét lại"
                       Command="{Binding RefreshScanCommand}"
                       IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                       Icon="{ui:SymbolIcon ArrowSync24}"/>
        </Grid>

        <!-- Scanning Status Bar -->
        <ui:Card Grid.Row="1"
                 Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Margin="0,0,0,12" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ui:TextBlock Grid.Row="0"
                              Text="{Binding ScanStatusText}"
                              FontTypography="BodyStrong"
                              Margin="0,0,0,8"/>
                <ProgressBar Grid.Row="1"
                             Value="{Binding ScanProgress}"
                             Height="6"
                             IsIndeterminate="{Binding ScanProgress, Converter={StaticResource ZeroToIndeterminateConverter}, FallbackValue=False}"/>
            </Grid>
        </ui:Card>

        <!-- Games List -->
        <ScrollViewer x:Name="GamesScrollViewer" Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Games}" Margin="0,0,16,0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Game Image Banner (Steam Header) -->
                                <Border Grid.Column="0"
                                        Width="140"
                                        Height="65"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Margin="0,0,16,0">
                                    <Grid>
                                        <Image Source="{Binding BannerUrl, IsAsync=True}"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Stretch="UniformToFill"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Visibility="{Binding BannerUrl, Converter={StaticResource NullToVisibilityConverter}}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="4"/>
                                    </Grid>
                                </Border>

                                <!-- Game Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <ui:TextBlock Text="{Binding Name}"
                                                      FontTypography="BodyStrong"
                                                      VerticalAlignment="Center"/>
                                        <!-- Status Badge -->
                                        <Border Background="{Binding StatusBadgeColor}"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}"
                                                      Appearance="Secondary"
                                                      Margin="0,0,16,0"/>

                                        <ui:TextBlock Text="{Binding TotalSizeFormatted}"
                                                      Appearance="Secondary"
                                                      Margin="0,0,16,0"/>

                                        <ui:TextBlock Text="{Binding LastModifiedFormatted, StringFormat='Lần sửa cuối: {0}'}"
                                                      Appearance="Tertiary"/>
                                    </StackPanel>

                                    <ui:TextBlock Text="{Binding StatusMessage}"
                                                  Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                  Margin="0,4,0,0"
                                                  Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <ui:Button Command="{Binding DataContext.OpenSaveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon Folder24}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Mở thư mục"/>
                                                <Setter Property="ToolTip" Value="Mở thư mục"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Command="{Binding DataContext.EditCustomGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding IsCustomGame, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon Edit24}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Sửa"/>
                                                <Setter Property="ToolTip" Value="Sửa"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Command="{Binding DataContext.DeleteCustomGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               Visibility="{Binding IsCustomGame, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Appearance="Danger"
                                               Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon Delete24}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Xóa"/>
                                                <Setter Property="ToolTip" Value="Xóa"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Appearance="Primary"
                                               Command="{Binding DataContext.SyncGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                               Icon="{ui:SymbolIcon CloudArrowUp24}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Sao lưu lên GitHub"/>
                                                <Setter Property="ToolTip" Value="Sao lưu lên GitHub"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
