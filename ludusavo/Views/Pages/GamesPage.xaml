<UserControl x:Class="ludusavo.Views.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ludusavo.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GamesViewModel}">

    <DockPanel PreviewMouseDown="Page_PreviewMouseDown" Background="Transparent">
        <!-- Action Toolbar (Native flat panel without ToolBarTray frames) -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,6">
            <!-- Modern Clean Search Box (No emoji, subtle text) -->
            <Grid Width="170" Margin="0,0,8,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,3" VerticalContentAlignment="Center"/>
                <TextBlock Text="Search games..."
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Content="Add Custom Game" Command="{Binding AddCustomGameCommand}" Margin="0,0,6,0" Padding="8,3"/>
            <Button Content="Rescan" Command="{Binding RefreshScanCommand}" Margin="0,0,12,0" Padding="8,3"/>

            <Button Content="Backup to Cloud"
                    Command="{Binding SyncGameCommand}"
                    CommandParameter="{Binding SelectedGame}"
                    IsEnabled="{Binding SelectedGame, Converter={StaticResource NotNullToBooleanConverter}}"
                    Margin="0,0,6,0" Padding="8,3"/>
            <Button Content="Open Folder"
                    Command="{Binding OpenSaveFolderCommand}"
                    CommandParameter="{Binding SelectedGame}"
                    IsEnabled="{Binding SelectedGame, Converter={StaticResource NotNullToBooleanConverter}}"
                    Margin="0,0,6,0" Padding="8,3"/>
            <Button Content="Pin / Unpin"
                    Command="{Binding TogglePinCommand}"
                    CommandParameter="{Binding SelectedGame}"
                    IsEnabled="{Binding SelectedGame, Converter={StaticResource NotNullToBooleanConverter}}"
                    Margin="0,0,6,0" Padding="8,3"/>
        </WrapPanel>

        <!-- Scanning Status Bar -->
        <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0,8,6">
            <TextBlock Text="{Binding ScanStatusText}" Margin="0,0,0,2"/>
            <ProgressBar Value="{Binding ScanProgress}" Height="8"
                         IsIndeterminate="{Binding ScanProgress, Converter={StaticResource ZeroToIndeterminateConverter}, FallbackValue=False}"/>
        </StackPanel>

        <!-- ListView (Flush with edges: BorderThickness="0,1,0,0") -->
        <ListView ItemsSource="{Binding Games}"
                  SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                  PreviewMouseDown="ListView_PreviewMouseDown"
                  BorderThickness="0,1,0,0"
                  Padding="0"
                  Margin="0"
                  ScrollViewer.CanContentScroll="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Backup to Cloud"
                              Command="{Binding SyncGameCommand}"
                              CommandParameter="{Binding SelectedGame}"/>
                    <MenuItem Header="Open Save Folder"
                              Command="{Binding OpenSaveFolderCommand}"
                              CommandParameter="{Binding SelectedGame}"/>
                    <MenuItem Header="Pin / Unpin"
                              Command="{Binding TogglePinCommand}"
                              CommandParameter="{Binding SelectedGame}"/>
                    <Separator Visibility="{Binding SelectedGame.IsCustomGame, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                    <MenuItem Header="Edit Custom Game"
                              Command="{Binding EditCustomGameCommand}"
                              CommandParameter="{Binding SelectedGame}"
                              Visibility="{Binding SelectedGame.IsCustomGame, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                    <MenuItem Header="Delete Custom Game"
                              Command="{Binding DeleteCustomGameCommand}"
                              CommandParameter="{Binding SelectedGame}"
                              Visibility="{Binding SelectedGame.IsCustomGame, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <!-- Steam Header Banner (Rounded corners) -->
                    <GridViewColumn Header="Banner" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="92" Height="43" Margin="0,2" Background="#15000000" HorizontalAlignment="Center">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,92,43" RadiusX="3" RadiusY="3"/>
                                    </Border.Clip>
                                    <Image Source="{Binding BannerUrl, IsAsync=True}"
                                           Width="92" Height="43"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Title" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                    <TextBlock Text=" [Pinned]" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                               Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Status" Width="185" DisplayMemberBinding="{Binding DisplayStatus}"/>

                    <!-- Files: Centered -->
                    <GridViewColumn Header="Files" Width="75">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Size: Right-aligned -->
                    <GridViewColumn Header="Size" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalSizeFormatted}"
                                           HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Last Modified: Centered -->
                    <GridViewColumn Header="Last Modified" Width="145">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastModifiedFormatted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
