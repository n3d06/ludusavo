<Page x:Class="ludusavo.Views.Pages.CloudPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:ludusavo.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:CloudViewModel}"
      Title="CloudPage"
      Background="Transparent">

    <Grid Margin="20,16,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <ui:TextBlock Text="{Binding RateLimitInfo}"
                              Appearance="Secondary"
                              Margin="0,4,0,0"/>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Content="Làm mới"
                       Command="{Binding RefreshCloudSavesCommand}"
                       IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                       Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>

        <!-- Status / Notice -->
        <ui:Card Grid.Row="1" Margin="0,0,20,14" Padding="16,12">
            <ui:TextBlock Text="{Binding StatusText}" FontTypography="Body"/>
        </ui:Card>

        <!-- Remote Saves List -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding RemoteSaves}" Margin="0,0,0,0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,20,10" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Game Image Banner (Steam Header) -->
                                <Border Grid.Column="0"
                                        Width="140"
                                        Height="65"
                                        CornerRadius="6"
                                        ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Margin="0,0,16,0">
                                    <Grid>
                                        <Image Source="{Binding BannerUrl}"
                                               Stretch="UniformToFill"/>
                                        <TextBlock Text="{Binding GameName}"
                                                   Visibility="{Binding BannerUrl, Converter={StaticResource NullToVisibilityConverter}}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="4"/>
                                    </Grid>
                                </Border>

                                <!-- Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding GameName}"
                                                  FontTypography="BodyStrong"
                                                  Margin="0,0,0,6"/>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}"
                                                      Appearance="Secondary"
                                                      Margin="0,0,16,0"/>

                                        <ui:TextBlock Text="{Binding FormattedSize}"
                                                      Appearance="Secondary"
                                                      Margin="0,0,16,0"
                                                      Visibility="{Binding FormattedSize, Converter={StaticResource StringToVisibilityConverter}}"/>

                                        <ui:TextBlock Text="{Binding FormattedTimestamp}"
                                                      Appearance="Tertiary"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ui:Button Command="{Binding DataContext.DeleteCloudSaveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                               Margin="0,0,8,0"
                                               Icon="{ui:SymbolIcon Delete24}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Xóa"/>
                                                <Setter Property="ToolTip" Value="Xóa bản sao lưu trên Cloud"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Appearance="Primary"
                                               Command="{Binding DataContext.DownloadAndRestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               IsEnabled="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                               Icon="{ui:SymbolIcon ArrowDownload24}">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Khôi phục về máy"/>
                                                <Setter Property="ToolTip" Value="Khôi phục về máy"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Content" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
