<UserControl x:Class="ludusavo.Views.Pages.CloudPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ludusavo.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CloudViewModel}">

    <DockPanel PreviewMouseDown="Page_PreviewMouseDown" Background="Transparent">
        <!-- Top Toolbar (Native flat panel without ToolBarTray frames) -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,6">
            <!-- Modern Clean Search Box (No emoji, subtle text) -->
            <Grid Width="170" Margin="0,0,8,0">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Search cloud saves..."
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Content="Refresh" Command="{Binding RefreshCloudSavesCommand}" Margin="0,0,12,0" Padding="8,3"/>

            <Button Content="Restore to PC"
                    Command="{Binding DownloadAndRestoreCommand}"
                    CommandParameter="{Binding SelectedSave}"
                    IsEnabled="{Binding SelectedSave, Converter={StaticResource NotNullToBooleanConverter}}"
                    Margin="0,0,6,0" Padding="8,3"/>
            <Button Content="Delete Cloud Save"
                    Command="{Binding DeleteCloudSaveCommand}"
                    CommandParameter="{Binding SelectedSave}"
                    IsEnabled="{Binding SelectedSave, Converter={StaticResource NotNullToBooleanConverter}}"
                    Margin="0,0,6,0" Padding="8,3"/>
        </WrapPanel>
 
        <!-- ListView (Flush with edges: BorderThickness="0,1,0,0") -->
        <ListView ItemsSource="{Binding RemoteSaves}"
                  SelectedItem="{Binding SelectedSave, Mode=TwoWay}"
                  PreviewMouseDown="ListView_PreviewMouseDown"
                  PreviewMouseRightButtonDown="ListView_PreviewMouseRightButtonDown"
                  BorderThickness="0,1,0,0"
                  BorderBrush="#E5E5E5"
                  Padding="0"
                  Margin="0"
                  ScrollViewer.CanContentScroll="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ContextMenu>
                <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Restore to PC"
                              Command="{Binding DownloadAndRestoreCommand}"
                              CommandParameter="{Binding SelectedSave}"/>
                    <MenuItem Header="Delete Cloud Save"
                              Command="{Binding DeleteCloudSaveCommand}"
                              CommandParameter="{Binding SelectedSave}"/>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <!-- Steam Header Banner (Rounded corners) -->
                    <GridViewColumn Header="Banner" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="92" Height="43" Margin="0,2" Background="#15000000" HorizontalAlignment="Center">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,92,43" RadiusX="3" RadiusY="3"/>
                                    </Border.Clip>
                                    <Image Source="{Binding BannerUrl, IsAsync=True}"
                                           Width="92" Height="43"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Title" Width="315" DisplayMemberBinding="{Binding GameName}"/>

                    <!-- Files: Centered -->
                    <GridViewColumn Header="Files" Width="85">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} files'}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Size: Right aligned -->
                    <GridViewColumn Header="Size" Width="105">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedSize}"
                                           HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Backup Time: Centered -->
                    <GridViewColumn Header="Backup Time" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FormattedTimestamp}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
