<Page x:Class="ludusavo.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:ludusavo.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      Title="SettingsPage"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16,0,20" HorizontalAlignment="Stretch">

            <!-- GitHub Configuration Card -->
            <ui:Card Margin="0,0,20,14" Padding="18">
                <StackPanel>
                    <ui:TextBlock Text="Cấu hình tài khoản GitHub"
                                  FontTypography="BodyStrong"
                                  Margin="0,0,0,14"/>

                    <ui:TextBlock Text="Personal Access Token (yêu cầu quyền repo):"
                                  Appearance="Secondary"
                                  Margin="0,0,0,6"/>
                    <ui:PasswordBox x:Name="TokenBox"
                                    PasswordChanged="TokenBox_PasswordChanged"
                                    Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <ui:TextBlock Text="GitHub Owner (Tên tài khoản hoặc Tổ chức):"
                                          Appearance="Secondary"
                                          Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <ui:TextBlock Text="GitHub Repository:"
                                          Appearance="Secondary"
                                          Margin="0,0,0,6"/>
                            <ui:TextBox Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Kiểm tra kết nối"
                                   Command="{Binding TestConnectionCommand}"
                                   IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon PlugConnected24}"/>

                        <ui:TextBlock Text="{Binding TestStatusMessage}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Automation & Behavior -->
            <ui:Card Margin="0,0,20,8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock Text="Tự động sao lưu &amp; đồng bộ khi tắt game" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="Phát hiện khi bạn chơi xong và tự động đẩy bản save mới nhất lên GitHub." Appearance="Secondary" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoSyncOnExit}" VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,20,8" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock Text="Thu nhỏ xuống Khay hệ thống (System Tray)" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="Khi bấm nút X đóng cửa sổ, ứng dụng sẽ chạy ngầm dưới góc phải màn hình." Appearance="Secondary" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,20,18" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <ui:TextBlock Text="Khởi động cùng Windows" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="Tự động khởi động ngầm cùng máy tính để bảo vệ file save của bạn liên tục." Appearance="Secondary" />
                    </StackPanel>

                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <!-- Save Settings Button -->
            <ui:Button Content="Lưu cấu hình"
                       Appearance="Primary"
                       Command="{Binding SaveSettingsCommand}"
                       HorizontalAlignment="Left"
                       Icon="{ui:SymbolIcon Save24}"/>

        </StackPanel>
    </ScrollViewer>
</Page>
