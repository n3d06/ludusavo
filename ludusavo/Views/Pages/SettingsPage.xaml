<UserControl x:Class="ludusavo.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ludusavo.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16" MaxWidth="680" HorizontalAlignment="Left">

            <!-- GitHub Configuration Section -->
            <TextBlock Text="GitHub Account Configuration" FontWeight="SemiBold" FontSize="14"/>
            <Separator Margin="0,4,0,14"/>

            <Label Content="Personal Access Token (requires repo scope):" Padding="0,0,0,4"/>
            <PasswordBox x:Name="TokenBox"
                         PasswordChanged="TokenBox_PasswordChanged"
                         Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="GitHub Owner (Username or Organization):" Padding="0,0,0,4"/>
                    <TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="GitHub Repository:" Padding="0,0,0,4"/>
                    <TextBox Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="12,4"/>
                <TextBlock Text="{Binding TestStatusMessage}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </StackPanel>

            <!-- System Options Section -->
            <TextBlock Text="System Preferences" FontWeight="SemiBold" FontSize="14"/>
            <Separator Margin="0,4,0,14"/>

            <CheckBox IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Minimize to System Tray" FontWeight="Medium"/>
                    <TextBlock Text="When closing the window, keep the app running in the system tray." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>

            <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Start with Windows" FontWeight="Medium"/>
                    <TextBlock Text="Automatically launch minimized on system startup to sync game saves." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>

            <!-- Save Settings Button -->
            <Button Content="Save Settings"
                    IsDefault="True"
                    Command="{Binding SaveSettingsCommand}"
                    HorizontalAlignment="Left"
                    Padding="20,6"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
