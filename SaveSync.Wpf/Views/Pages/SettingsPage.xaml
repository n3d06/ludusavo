<Page x:Class="SaveSync.Desktop.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:SaveSync.Desktop.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      Title="SettingsPage"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,0,20,20" HorizontalAlignment="Stretch">

            <TextBlock Text="Cài đặt hệ thống"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- GitHub Configuration Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,14"
                    HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Cấu hình tài khoản GitHub"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Personal Access Token (yêu cầu quyền repo):"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TokenBox"
                                 PasswordChanged="TokenBox_PasswordChanged"
                                 Margin="0,0,0,14"
                                 Height="34"/>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="GitHub Owner (Tên tài khoản hoặc Tổ chức):"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="GitHub Repository:"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding GitHubRepo, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Kiểm tra kết nối"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                Padding="16,0"
                                Height="34"/>

                        <TextBlock Text="{Binding TestStatusMessage}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Automation & Behavior Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,18"
                    HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Tính năng tự động hóa"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Auto Sync on Game Exit -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tự động sao lưu &amp; đồng bộ khi tắt game"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Phát hiện khi bạn chơi xong và tự động đẩy bản save mới nhất lên GitHub."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoSyncOnExit}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Minimize to Tray -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thu nhỏ xuống Khay hệ thống (System Tray)"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Khi bấm nút X đóng cửa sổ, ứng dụng sẽ chạy ngầm dưới góc phải màn hình."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Start with Windows -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Khởi động cùng Windows"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Tự động khởi động ngầm cùng máy tính để bảo vệ file save của bạn liên tục."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save Settings Button -->
            <Button Content="Lưu cấu hình"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveSettingsCommand}"
                    HorizontalAlignment="Left"
                    Height="36"
                    Padding="24,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>
