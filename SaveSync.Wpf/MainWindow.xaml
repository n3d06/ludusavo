<Window x:Class="SaveSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SaveSync.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="icon-512.ico"
        Height="720" Width="1080"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <DockPanel>
        <!-- Top Status Bar: Title, Status -->
        <Border DockPanel.Dock="Top"
                Background="#FFFFFF"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tiêu đề đã được ẩn theo yêu cầu -->
                </StackPanel>

                <!-- GitHub Connection Status Badge -->
                <Border Grid.Column="2"
                        Background="#F8FAFC"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding IsGitHubConnected, Converter={StaticResource BoolToBrushConverter}}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GitHubStatusText}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Modern Flat TabControl -->
        <TabControl x:Name="MainTabs">
            <TabItem Header="Game trên máy" x:Name="TabGames">
                <Frame x:Name="GamesFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
            </TabItem>
            <TabItem Header="Sao lưu Cloud" x:Name="TabCloud">
                <Frame x:Name="CloudFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
            </TabItem>
            <TabItem Header="Cài đặt" x:Name="TabSettings">
                <Frame x:Name="SettingsFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
